# Banco PostgreSQL. Em produção, use a connection string do Neon.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/indicadores?schema=public"

# Agente: configure pelo menos uma opção.
# Recomendado: OpenAI com pesquisa web integrada.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-sol"

# Alternativa/fallback para descoberta de páginas.
TAVILY_API_KEY=""

# Quantos indicadores o agente analisa por execução automática.
AGENT_MAX_INDICATORS="8"

# Proteção opcional quando publicar no Render.
BASIC_AUTH_USER="vicosasmart"
BASIC_AUTH_PASSWORD=""

PORT="3000"
NODE_ENV="development"
